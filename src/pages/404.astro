---
import BaseLayout from '../layouts/BaseLayout.astro'
import { NotFoundPage } from '../views/NotFoundPage'
import { SITE_NAME, OG_IMAGE, type PageSeo } from '../data/site'

const seo: PageSeo = {
  title: `Page Not Found | Tarkov Hacks & EFT Cheats`,
  description: `Page not found on hacksfortarkov.org. Browse Tarkov hacks guides for aimbot, ESP, wallhack, radar hack, loot ESP and BattlEye status instead.`,
  path: '/404',
  image: OG_IMAGE,
  robots: 'noindex, follow',
  ogType: 'website',
}
---

<BaseLayout seo={seo}>
  <NotFoundPage client:visible />
</BaseLayout>

